{
  "permissions": {
    "allow": [
      "Bash(bq query --use_legacy_sql=false --dry_run *)",
      "Bash(bq ls *)",
      "Bash(bq show *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "ask": [
      "Bash(bq query *)"
    ],
    "deny": [
      "Bash(bq rm *)",
      "Bash(bq load *)",
      "Bash(bq mk *)",
      "Bash(bq cp *)",
      "Read(./.env)",
      "Read(~/.config/gcloud/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde_cout_bq.py\"", "timeout": 30 }
        ]
      }
    ]
  }
}
